<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_RHMaster" targetNamespace="https://github.com/prometheus-0411/rh-master" exporter="RH Master" exporterVersion="0.2">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="P_app" name="RH Master v0.2 — analyse d'un dossier" processRef="Proc" />
    <bpmn:participant id="P_claude" name="API Claude (Anthropic)" />
    <bpmn:messageFlow id="M1" name="Demande" sourceRef="T5" targetRef="P_claude" />
    <bpmn:messageFlow id="M2" name="Réponse" sourceRef="P_claude" targetRef="T5" />
    <bpmn:messageFlow id="M3" name="" sourceRef="T9" targetRef="P_claude" />
    <bpmn:messageFlow id="M4" name="" sourceRef="P_claude" targetRef="T9" />
    <bpmn:messageFlow id="M5" name="" sourceRef="T14" targetRef="P_claude" />
    <bpmn:messageFlow id="M6" name="" sourceRef="P_claude" targetRef="T14" />
  </bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_testeur" name="Testeur">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_nav" name="App (navigateur)">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_serveur" name="Serveur RH Master (Vercel, Paris)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Lien et code d'invitation reçus">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Ouvrir l'app et saisir son code">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Vérifier le code et la connexion à la base">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:property id="Prop_T2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_T2"><bpmn:sourceRef>DS1</bpmn:sourceRef><bpmn:targetRef>Prop_T2</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Accès accordé ?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Afficher le motif du refus">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Accès refusé">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T4" name="Renseigner le dossier : CV, offre, situation, salaires">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Offre donnée par lien ?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Faire lire la page de l'offre par Claude">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Offre lisible ?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T6" name="Proposer le copier-coller">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6b" name="Coller le texte de l'offre">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6a" name="Afficher le texte récupéré, à relire">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Lancer la lecture recruteur">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5" name="Plafonds disponibles ?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T8" name="Afficher « plafond atteint »">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Analyse refusée">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T9" name="Réserver un appel et demander la lecture recruteur">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_T9"><bpmn:targetRef>DS2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G6" name="Réponse valide ?">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T11" name="Afficher l'erreur, relance possible">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E3" name="Erreur signalée">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T12" name="Afficher verdict, score, écarts et questions">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T13" name="Lancer valeur marché et négociation">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T14" name="Rechercher des salaires (option web) et préparer la négociation">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T15" name="Afficher fourchette, sources et stratégie">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T16" name="Télécharger la fiche et donner son avis">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T17" name="Enregistrer le retour, sans le CV">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_T17"><bpmn:targetRef>DS3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="E4" name="Dossier analysé, retour enregistré">
      <bpmn:incoming>F30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="non" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T3" targetRef="E1" />
    <bpmn:sequenceFlow id="F6" name="oui" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="oui" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" name="non" sourceRef="G2" targetRef="G4" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T5" targetRef="G3" />
    <bpmn:sequenceFlow id="F11" name="non" sourceRef="G3" targetRef="T6" />
    <bpmn:sequenceFlow id="F12" name="" sourceRef="T6" targetRef="T6b" />
    <bpmn:sequenceFlow id="F13" name="" sourceRef="T6b" targetRef="G4" />
    <bpmn:sequenceFlow id="F14" name="oui" sourceRef="G3" targetRef="T6a" />
    <bpmn:sequenceFlow id="F15" name="" sourceRef="T6a" targetRef="G4" />
    <bpmn:sequenceFlow id="F16" name="" sourceRef="G4" targetRef="T7" />
    <bpmn:sequenceFlow id="F17" name="" sourceRef="T7" targetRef="G5" />
    <bpmn:sequenceFlow id="F18" name="non" sourceRef="G5" targetRef="T8" />
    <bpmn:sequenceFlow id="F19" name="" sourceRef="T8" targetRef="E2" />
    <bpmn:sequenceFlow id="F20" name="oui" sourceRef="G5" targetRef="T9" />
    <bpmn:sequenceFlow id="F21" name="" sourceRef="T9" targetRef="G6" />
    <bpmn:sequenceFlow id="F22" name="non" sourceRef="G6" targetRef="T11" />
    <bpmn:sequenceFlow id="F23" name="" sourceRef="T11" targetRef="E3" />
    <bpmn:sequenceFlow id="F24" name="oui" sourceRef="G6" targetRef="T12" />
    <bpmn:sequenceFlow id="F25" name="" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="F26" name="" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F27" name="" sourceRef="T14" targetRef="T15" />
    <bpmn:sequenceFlow id="F28" name="" sourceRef="T15" targetRef="T16" />
    <bpmn:sequenceFlow id="F29" name="" sourceRef="T16" targetRef="T17" />
    <bpmn:sequenceFlow id="F30" name="" sourceRef="T17" targetRef="E4" />
    <bpmn:dataStoreReference id="DS1" name="Compteurs et retours" dataStoreRef="Store" />
    <bpmn:dataStoreReference id="DS2" name="Compteurs et retours" dataStoreRef="Store" />
    <bpmn:dataStoreReference id="DS3" name="Compteurs et retours" dataStoreRef="Store" />
    <bpmn:textAnnotation id="A1"><bpmn:text>Échec : la réservation est annulée, l'appel n'est pas décompté.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A1" sourceRef="T11" targetRef="A1" />
    <bpmn:textAnnotation id="A2"><bpmn:text>Même contrôle des plafonds qu'avant la lecture recruteur. Recherche web en option : 1 à 5 requêtes, sources citées.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A2" sourceRef="T14" targetRef="A2" />
    <bpmn:textAnnotation id="A3"><bpmn:text>Le CV et l'offre ne sont jamais enregistrés : seuls les compteurs et les retours le sont.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A3" sourceRef="DS3" targetRef="A3" />
  </bpmn:process>
  <bpmn:dataStore id="Store" name="Base Upstash" />
