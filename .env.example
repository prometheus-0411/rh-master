# Copiez ce fichier en .env.local pour tester sur votre ordinateur.
# Sur Vercel, ces valeurs se saisissent dans Settings → Environment Variables (jamais dans le code).

# Clé API Anthropic (console.anthropic.com → API Keys). Obligatoire.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé (laisser vide pour la valeur par défaut : claude-opus-5-5).
ANTHROPIC_MODEL=

# Codes d'invitation des testeurs, séparés par des virgules.
# Format : CODE:LIMITE (LIMITE = nombre d'appels à Claude autorisés pour ce code).
# Un code par testeur : son retour est rattaché à son code.
# Inventez des codes difficiles à deviner (voir README, « Choisir les codes »). Le code ci-dessous est refusé par l'app.
ACCES_CODES=EXEMPLE-A-REMPLACER:20

# Limite par défaut si un code est écrit sans « :LIMITE ».
LIMITE_PAR_CODE=20

# Plafond global d'appels à Claude par jour, tous testeurs confondus (protège votre budget).
LIMITE_JOUR=30

# Mot de passe de la page /admin (retours testeurs et consommation).
ADMIN_CODE=

# Base de données des retours et compteurs (Upstash Redis, gratuit via Vercel → Storage).
# Vercel remplit ces deux variables automatiquement quand vous connectez la base au projet.
# Sans elles : `npm run dev` fonctionne (mémoire effacée à chaque redémarrage) ; en production, l'app refuse les analyses.
# Pour un essai local avec `npm start` sans base, décommentez la ligne suivante (jamais sur Vercel).
# AUTORISER_SANS_BASE=1
KV_REST_API_URL=
KV_REST_API_TOKEN=
